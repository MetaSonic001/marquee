QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
GROQ_API_KEY=
# Supabase session pooler (IPv4). SQLite is used if unset (local dev only).
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
APP_SECRET=change-me
FRONTEND_ORIGIN=http://localhost:3010
PUBLIC_BASE_URL=http://localhost:8010
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_AGENT_MODEL=openai/gpt-oss-120b
GROQ_WRITER_MODEL=qwen/qwen3.8-27b
GROQ_SEARCH_MODEL=openai/gpt-oss-20b
WEB_RESEARCH_BRANDS=4
